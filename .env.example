# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/Farely

# JWT (required)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (SSO) – public client IDs only (no secret).
# Native Android sign-in uses webClientId from Expo → ID token "aud" is usually the WEB client.
# Set GOOGLE_WEB_CLIENT_ID to the SAME value as frontend app.json extra.googleWebClientId (required for /auth/google).
GOOGLE_WEB_CLIENT_ID=732209755307-73gv7r389hrjmhhcprc0ib25ehabl235.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=732209755307-krgg4q36fnod5n3henpbr2qq65q1o8pt.apps.googleusercontent.com
# Optional extra audience (e.g. Android OAuth client id string) — not required if WEB id matches token aud
GOOGLE_CLIENT_ID=

# Twilio (SMS OTP – free trial at twilio.com)
# Verify API: no phone number needed – Twilio sends and checks the code
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Leave TWILIO_PHONE_NUMBER unset – no need to buy a number

# Brevo (email OTP & forgot password – free tier at brevo.com)
# Both required: API key + a sender email that is verified in Brevo (Sender & Domains)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional: same values are reused by farely-admin for Support Inbox (transactional send + webhooks).
# Copy these into farely-admin/backend/.env when enabling Brevo there:
# BREVO_SENDER_NAME=  BREVO_WEBHOOK_SECRET=  BREVO_INBOUND_DOMAIN=  BREVO_INBOUND_TOKEN=
# BREVO_INBOUND_LOCAL_PREFIX=farely  BREVO_PUBLIC_SUPPORT_EMAIL=


# AWS S3 (profile photos) – see backend/docs/AWS_S3_SETUP.md for step-by-step setup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
# Optional: custom URL for profile photos (e.g. CDN)
# AWS_S3_PUBLIC_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Pakistan POL for ride estimates (OGRA is official; no stable free JSON API from OGRA itself)
# Most exact: set after each OGRA fortnightly notification (PKR per litre)
PAK_PETROL_PKR=399.86
PAK_DIESEL_PKR=399.58
PAK_FUEL_EFFECTIVE_FROM=2026-05-01
#
# Or point to YOUR JSON URL (Cloud Function / worker that parses OGRA or a licensed feed):
# PAK_FUEL_JSON_URL=https://your-worker.example.com/api/pak-fuel
# PAK_FUEL_API_KEY=...   (optional; sent as Bearer unless PAK_FUEL_API_KEY_HEADER is set)
# PAK_FUEL_API_KEY_HEADER=X-Api-Key
#
# Baseline for multiplier curve when petrol PKR is known (tune to your last “normal” OGRA price)
# FUEL_BASELINE_PETROL_PKR=320
# FUEL_SURCHARGE_FALLBACK=1.03   # used when no petrol figure is available
# PAK_FUEL_CACHE_MS=21600000      # default 6h
# PAK_FUEL_SKIP_OGRA=true        # skip HTML parse if you only use env/JSON


