{
  "info": {
    "name": "Farely API",
    "description": "Auth and Profile APIs for Farely backend. Set `baseUrl` (default http://localhost:3000) and after login/set-password the `token` is saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "Check if the API is running."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"3001234567\",\n  \"countryCode\": \"+92\",\n  \"gender\": \"male\",\n  \"otpChannel\": \"email\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Sends OTP to email or phone. Use otpChannel: \"email\" or \"phone\". Then call Verify OTP → Set Password."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"channel\": \"email\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-otp",
            "description": "Resend OTP. identifier = email or phone; channel = email|phone; purpose = signup|forgot_password."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"channel\": \"email\",\n  \"purpose\": \"signup\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp",
            "description": "Enter the OTP you received. After success, call Set Password (signup) or Reset Password (forgot_password)."
          }
        },
        {
          "name": "Set Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"channel\": \"email\",\n  \"password\": \"TestPass123\",\n  \"confirmPassword\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/set-password",
            "description": "After Verify OTP (signup). Saves token to collection variable for protected routes."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"test@example.com\",\n  \"password\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "loginId = email or phone. Saves token to collection variable."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me",
            "description": "Get current user. Requires token (run Login or Set Password first)."
          }
        },
        {
          "name": "Google Sign-In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN_HERE\"\n}"
            },
            "url": "{{baseUrl}}/auth/google",
            "description": "Replace idToken with the token from your app's Google Sign-In."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"identifier\": \"test@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Sends OTP. Then Verify Forgot Password OTP → Reset Password."
          }
        },
        {
          "name": "Verify Forgot Password OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"channel\": \"email\",\n  \"purpose\": \"forgot_password\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-forgot-password-otp",
            "description": "Same as Verify OTP with purpose forgot_password. Then call Reset Password."
          }
        },
        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"channel\": \"email\",\n  \"password\": \"NewPass123\",\n  \"confirmPassword\": \"NewPass123\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "Set new password. Can include otp, or omit if you just verified in the last 15 min."
          }
        },
        {
          "name": "Change Password (logged in)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"YourCurrentPass123\",\n  \"newPassword\": \"NewPass456\",\n  \"confirmNewPassword\": \"NewPass456\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password",
            "description": "Logged-in user only (Bearer). Separate from forgot-password / reset-password. Body: currentPassword, newPassword, confirmNewPassword. Returns new JWT."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/profile",
            "description": "Get current user profile. Requires token."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phone\": \"3001234567\",\n  \"email\": \"test@example.com\",\n  \"street\": \"123 Main St\",\n  \"city\": \"Lahore\",\n  \"district\": \"Central\"\n}"
            },
            "url": "{{baseUrl}}/profile",
            "description": "Update profile. All fields optional."
          }
        },
        {
          "name": "Upload Profile Photo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "photo", "type": "file", "src": "", "description": "Select an image (JPEG/PNG/WebP, max 5MB)" }
              ]
            },
            "url": "{{baseUrl}}/profile/photo",
            "description": "Upload profile photo. Body: form-data, key = photo, value = file."
          }
        }
      ]
    },
    {
      "name": "Payment Methods",
      "item": [
        {
          "name": "List Payment Methods",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/payment-methods",
            "description": "List saved card payment methods for the logged-in user."
          }
        },
        {
          "name": "Add Payment Method",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Personal Visa\",\n  \"brand\": \"visa\"\n}"
            },
            "url": "{{baseUrl}}/payment-methods",
            "description": "Creates a saved card. In Stripe test mode, brand maps to test payment method tokens."
          }
        },
        {
          "name": "Set Default Payment Method",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDefault\": true\n}"
            },
            "url": "{{baseUrl}}/payment-methods/:id",
            "description": "Set a specific card as default by replacing :id with payment method id."
          }
        },
        {
          "name": "Delete Payment Method",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/payment-methods/:id",
            "description": "Delete a saved payment method."
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet/balance"
          }
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet/history"
          }
        },
        {
          "name": "Top-up Wallet (Card)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"method\": \"card\",\n  \"paymentMethodId\": \"PUT_PAYMENT_METHOD_ID_HERE\"\n}"
            },
            "url": "{{baseUrl}}/wallet/topup"
          }
        },
        {
          "name": "Pay Ride",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"pay_123456\",\n  \"rideId\": \"ride_abc\",\n  \"method\": \"cash\",\n  \"amount\": 800,\n  \"paymentMethodId\": null,\n  \"meta\": {\n    \"provider\": \"Uber\",\n    \"pickup\": \"A\",\n    \"destination\": \"B\"\n  }\n}"
            },
            "url": "{{baseUrl}}/wallet/pay",
            "description": "Use method cash/card/wallet. For card include paymentMethodId."
          }
        }
      ]
    }
  ]
}
